{
  "manifest_version": 3,
  "name": "PageSentinel (working title)",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "Local website monitoring with readable changes and clear monitor health. No account required.",
  "permissions": ["alarms", "storage", "notifications", "activeTab", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "PageSentinel" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
