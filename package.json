    "domutils": "^3.2.2",
    "htmlparser2": "^10.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/chrome": "^0.1.24",
    "@types/diff": "^7.0.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "npm:esbuild-wasm@0.28.1",
    "eslint": "^9.39.0",
    "fake-indexeddb": "^6.2.4",
    "fflate": "^0.8.2",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "rollup": "npm:@rollup/wasm-node@4.65.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.2.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
